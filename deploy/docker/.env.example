# WarpTalk dev environment. Dung voi:  set -a; . deploy/docker/.env; set +a
# (scripts/dev-up.sh tu nap file nay neu co; neu chua co se tao tu .env.example).
# File .env KHONG commit (chua key that). Gia tri duoi day la gia tri DEV, khong phai bi mat that.

# ---- Docker compose (deploy/docker/docker-compose.yml) ----
POSTGRES_USER=postgres
POSTGRES_DB=warptalk
# Doi neu may da co Postgres/Redis o cong mac dinh (Homebrew...). Nho doi DATABASE_URL/REDIS_URL theo.
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Bat buoc cho api / worker / pipeline / migrator ----
# Postgres dev dung trust auth (khong mat khau)
DATABASE_URL=postgres://postgres@localhost:5432/warptalk
REDIS_URL=redis://localhost:6379
# >= 32 byte. Tao: openssl rand -base64 48 | tr -d '\n=+/'   (SECRET: dev-up.sh tu sinh neu de trong)
JWT_SECRET=

# ---- API ----
HTTP_BIND=127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEV ONLY: token xac minh email / loi moi ghi vao Redis (dev:mail:*) de demo-seed.sh doc.
DEV_MAIL_CAPTURE=1
RUST_LOG=info
# LOG_FORMAT=pretty
# METRICS_BIND=127.0.0.1:9090   (moi tien trinh mot cong rieng, de trong khi chay dev)

# ---- LiveKit (khop deploy/docker/livekit.yaml) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Qdrant (tim kiem knowledge; bo trong = in-memory, mat khi restart) ----
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Key AI nen tang (SECRET; bo trong = tinh nang tuong ung tat) ----
OPENAI_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OPENAI_STT_MODEL=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# ---- BYO LLM (key AI cua workspace) ----
# SECRET. Bo trong = BYO tat (API tra 503 BYO_DISABLED).
# Tao: openssl rand -base64 32      (dung 32 byte base64)
AI_KEYS_KEK=
# AI_KEYS_KEK_VERSION=1
# Cho phep baseUrl http/loopback (vd Ollama local). CHI DEV.
# AI_ALLOW_INSECURE_BASE_URL=true

# ---- Pipeline ----
# simulated = khong can LiveKit RTC (build mac dinh); livekit = can build --features livekit-rtc
MEDIA_TRANSPORT=simulated
# 1 = MT/TTS gia (chi voi simulated, khi khong co OPENAI_API_KEY)
PIPELINE_FAKE_PROVIDERS=1
# Danh sach participant id "noi" trong moi phong mo phong (phan cach bang dau phay)
# SIM_PARTICIPANTS=
# SIM_WAV_DIR=
# PIPELINE_LEASE_TTL_MS=15000
# PIPELINE_SCAN_INTERVAL_MS=5000
# PIPELINE_HOST_ID=

# ---- Web (apps/web, Vite dev server) ----
# API ma Vite proxy /api toi (mac dinh trong code: http://127.0.0.1:18080 -> o dev-up dat theo HTTP_BIND)
VITE_API_PROXY=http://127.0.0.1:8080
WEB_PORT=5173
