# syntax=docker/dockerfile:1.7
# WarpTalk web image. Build context = repo root:
#   docker build -f deploy/docker/Dockerfile.web -t warptalk-web .
#
# apps/web/next.config.ts builds a STATIC EXPORT (`output: 'export'` -> out/); `next start` does not
# work with it and the config must not change. The image therefore serves out/ with Caddy (static
# files, SPA fallback, gzip) and reverse-proxies /api/* to the backend (SSE-safe, no buffering).
#
# Runtime env:
#   API_PROXY_TARGET  backend base URL, e.g. http://api:8080   (default http://api:8080)
#   PORT              listen port inside the container         (default 8080)
# Build arg NEXT_PUBLIC_API_BASE_URL is baked into the bundle; leave empty (same origin) for the
# normal deployment where /api is routed to the API by this image or by the edge proxy.
# Expected size: ~60-80 MB (caddy alpine + static assets); verify with `docker images`.

ARG NODE_VERSION=22
ARG CADDY_VERSION=2.8

FROM node:${NODE_VERSION}-bookworm-slim AS build
ARG NEXT_PUBLIC_API_BASE_URL=""
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    CI=1
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY apps/web/ ./
RUN npm run build && test -f out/index.html

FROM caddy:${CADDY_VERSION}-alpine AS runtime
LABEL org.opencontainers.image.title="warptalk-web" \
      org.opencontainers.image.description="WarpTalk web app (Next.js static export served by Caddy, /api proxied to the backend)" \
      org.opencontainers.image.vendor="WarpTalk" \
      org.opencontainers.image.licenses="UNLICENSED"
RUN addgroup -S -g 10001 warptalk \
 && adduser -S -u 10001 -G warptalk -H -h /nonexistent -s /sbin/nologin warptalk \
 && mkdir -p /srv/www /config/caddy /data/caddy \
 && chown -R 10001:10001 /config /data
COPY --chown=10001:10001 deploy/docker/web.Caddyfile /etc/caddy/Caddyfile
COPY --from=build --chown=10001:10001 /app/apps/web/out /srv/www
ENV API_PROXY_TARGET=http://api:8080 \
    PORT=8080 \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=3 \
  CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1:${PORT}/healthz"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
