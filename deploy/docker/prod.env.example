# WarpTalk PRODUCTION env for docker-compose.prod.yml.
#   cp deploy/docker/prod.env.example deploy/docker/.env.prod   (".env.*" is git-ignored; NEVER commit it)
#   docker compose -f deploy/docker/docker-compose.prod.yml --env-file deploy/docker/.env.prod up -d
# Variable semantics: docs/RUNBOOK.md section 3. Empty value = unset. Generate secrets with:
#   openssl rand -hex 24                         (passwords: hex only, they are embedded in URLs)
#   openssl rand -base64 48 | tr -d '\n=+/'      (JWT_SECRET, >= 32 bytes)
#   openssl rand -base64 32                      (AI_KEYS_KEK, exactly 32 bytes base64; LOSING IT LOSES stored BYO keys)

# ---- Images ----
# Registry prefix of the images built by .github/workflows/docker.yml (lowercase), e.g. ghcr.io/acme
WARPTALK_REGISTRY=
# Image tag: a release (v1.2.3) or sha-<commit>. Pin it; avoid "latest" in production.
WARPTALK_TAG=

# ---- Edge proxy (profile "proxy") ----
DOMAIN=warptalk.example.com
# Without the proxy profile the web container is published on 127.0.0.1:${WEB_PORT} for your own proxy.
WEB_PORT=3000

# ---- Datastores (compose-internal) ----
POSTGRES_USER=warptalk
POSTGRES_DB=warptalk
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# ---- API ----
JWT_SECRET=
# JWT_ISSUER=WarpTalk.AuthService
# JWT_AUDIENCE=WarpTalk
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# Only needed if browsers call the API from ANOTHER origin (the bundled web proxies /api: not needed).
CORS_ORIGINS=
# DEV ONLY (=1 stores raw verification tokens in Redis). There is NO mailer yet: see docs/DEPLOY.md.
DEV_MAIL_CAPTURE=
RUST_LOG=info
LOG_FORMAT=json

# ---- AI keys (platform; empty = feature off) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
AI_KEYS_KEK=
AI_KEYS_KEK_VERSION=1

# ---- Document storage ----
# local (default): volume "objects" shared by api and worker. s3: fill the S3_* vars below.
STORAGE_PROVIDER=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_PUBLIC_ENDPOINT=
