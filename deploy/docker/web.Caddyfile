# Used INSIDE the warptalk-web image (Dockerfile.web). Plain HTTP; TLS is terminated by the edge proxy.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	handle /healthz {
		respond "ok" 200
	}

	# Backend. flush_interval -1: SSE streams (suggestions) must not be buffered.
	handle /api/* {
		reverse_proxy {$API_PROXY_TARGET:http://api:8080} {
			flush_interval -1
		}
	}

	handle {
		root * /srv/www
		encode zstd gzip
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin
		header X-Frame-Options SAMEORIGIN
		# Export layout: exact file, dir/index.html, <path>.html, else SPA root (client routes).
		try_files {path} {path}/index.html {path}.html /index.html
		file_server
	}
}
